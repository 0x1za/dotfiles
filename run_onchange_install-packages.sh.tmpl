#!/bin/sh
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
# Defaults hash: {{ include "dot_config/mise/config.toml" | sha256sum }} {{ include "dot_default-gems" | sha256sum }} {{ include "dot_default-npm-packages" | sha256sum }}
set -e
export PATH="/opt/homebrew/bin:$PATH"
brew bundle --file={{ joinPath .chezmoi.sourceDir "Brewfile" | quote }}
mise install --yes
