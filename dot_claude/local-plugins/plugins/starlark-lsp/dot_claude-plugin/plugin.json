{
  "name": "starlark-lsp",
  "description": "Bazel/Starlark language server (starpls) for Claude Code's LSP tool",
  "version": "1.0.0",
  "lspServers": {
    "starpls": {
      "command": "starpls",
      "extensionToLanguage": {
        ".bzl": "starlark",
        ".bazel": "starlark",
        ".star": "starlark"
      },
      "args": [
        "server"
      ]
    }
  }
}
