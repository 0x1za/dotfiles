# if you want to profile your zsh startup time
# uncomment the following line and run zprof as the first command in a new shell
# zmodload zsh/zprof  # uncomment + add `zprof` at end of file to profile startup

#------------------------------------------------------
# fpath additions (must come before compinit / oh-my-zsh)
#------------------------------------------------------
fpath+="${ZSH_CUSTOM:-${ZSH:-$HOME/.oh-my-zsh}/custom}/plugins/zsh-completions/src"

# Docker CLI completions
[ -d "$HOME/.docker/completions" ] && fpath=("$HOME/.docker/completions" $fpath)

#------------------------------------------------------
# Oh My Zsh
#------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)
source "$ZSH/oh-my-zsh.sh"

#------------------------------------------------------
# Environment
#------------------------------------------------------
# TERM is set by the terminal (xterm-ghostty) and by tmux (default-terminal in
# ~/.tmux.conf). Forcing it here breaks mode restore when TUI apps exit.

export VISUAL=nvim
export EDITOR="$VISUAL"

export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

#------------------------------------------------------
# PATH
#------------------------------------------------------
export PATH="$PATH:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH="$PATH:$HOME/.local/bin"

# Go
export GOPATH="$HOME/go"
export PATH="$PATH:$GOPATH/bin"

# Maven
M2_HOME="$HOME/apache-maven"
if [ -d "$M2_HOME" ]; then
  export PATH="${M2_HOME}/bin:${PATH}"
fi

# Flutter
if [ -d "$HOME/Mars/packages/flutter/bin" ]; then
  export PATH="$PATH:$HOME/Mars/packages/flutter/bin"
fi

# Android SDK
if [ -d "$HOME/Library/Android/Sdk" ]; then
  export ANDROID_HOME="$HOME/Library/Android/Sdk"
fi

# Apache Flink (resolves version dynamically via brew)
if FLINK_PREFIX="$(brew --prefix apache-flink 2>/dev/null)"; then
  export FLINK_PATH="${FLINK_PREFIX}/libexec"
fi

# Homebrew: ruby
if [ -d "/opt/homebrew/opt/ruby/bin" ]; then
  export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
fi

# Homebrew: libpq
if [ -d "/opt/homebrew/opt/libpq/bin" ]; then
  export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
  export LDFLAGS="-L/opt/homebrew/opt/libpq/lib"
  export CPPFLAGS="-I/opt/homebrew/opt/libpq/include"
fi

# Homebrew: llvm
if [ -d "/opt/homebrew/opt/llvm/bin" ]; then
  export PATH="/opt/homebrew/opt/llvm/bin:$PATH"
fi

# Antigravity
if [ -d "$HOME/.antigravity/antigravity/bin" ]; then
  export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
fi

#------------------------------------------------------
# History
#------------------------------------------------------
setopt SHARE_HISTORY
setopt HIST_IGNORE_SPACE
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_VERIFY
HISTSIZE=50000
SAVEHIST=$HISTSIZE

#------------------------------------------------------
# Keybindings
#------------------------------------------------------
bindkey -e
bindkey "^[[3~" delete-char

#------------------------------------------------------
# Aliases
#------------------------------------------------------
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../../'
alias ll="ls -asl"
alias week='date +%V'
alias python="python3"
alias serve='python -m http.server'

if [ -x "$(command -v nvim)" ]; then
  alias vim='nvim'
fi

if [ -x "$(command -v podman)" ]; then
  alias docker="podman"
fi

#------------------------------------------------------
# Tools
#------------------------------------------------------

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
if [[ -d "$PYENV_ROOT/bin" ]]; then
  export PATH="$PYENV_ROOT/bin:$PATH"
  eval "$(pyenv init -)"
fi

# Rust/Cargo
[ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"

# uv / pipx local bin
[ -f "$HOME/.local/bin/env" ] && source "$HOME/.local/bin/env"

# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# RVM
[ -d "$HOME/.rvm/bin" ] && export PATH="$PATH:$HOME/.rvm/bin"

# ghcup
[ -f "$HOME/.ghcup/env" ] && source "$HOME/.ghcup/env"

# chruby
CHRUBY_SCRIPT="${HOMEBREW_PREFIX}/opt/chruby/share/chruby/chruby.sh"
[ -f "$CHRUBY_SCRIPT" ] && source "$CHRUBY_SCRIPT"

# direnv
if [ -x "$(command -v direnv)" ]; then
  eval "$(direnv hook zsh)"
fi

# Google Cloud SDK
GCLOUD_DIR="$HOME/Downloads/google-cloud-sdk"
[ -f "$GCLOUD_DIR/path.zsh.inc" ] && source "$GCLOUD_DIR/path.zsh.inc"
[ -f "$GCLOUD_DIR/completion.zsh.inc" ] && source "$GCLOUD_DIR/completion.zsh.inc"

# conda
if [ -f "/opt/anaconda3/etc/profile.d/conda.sh" ]; then
  source "/opt/anaconda3/etc/profile.d/conda.sh"
elif [ -d "/opt/anaconda3/bin" ]; then
  export PATH="/opt/anaconda3/bin:$PATH"
fi

# Docker Desktop init
[ -f "$HOME/.docker/init-zsh.sh" ] && source "$HOME/.docker/init-zsh.sh"

# fzf
[ -f "$HOME/.fzf.zsh" ] && source "$HOME/.fzf.zsh"

# iTerm2 shell integration (only load inside iTerm2 to avoid raw escape sequences elsewhere)
[ "$TERM_PROGRAM" = "iTerm.app" ] && [ -f "$HOME/.iterm2_shell_integration.zsh" ] && source "$HOME/.iterm2_shell_integration.zsh"
