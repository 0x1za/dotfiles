# ==============================================================================
# WINDOW HEADER
# ==============================================================================
# Fixed window title. Ghostty ignores title escape sequences from programs
# (tmux, Neovim) while this is set, so the header never changes.
title = Winning on all fronts
window-title-font-family = "Fira Code"

# ==============================================================================
# FONT
# ==============================================================================
font-family = "Fira Code"
font-size = 12
font-feature = calt
font-feature = liga
adjust-cell-height = 10%

# ==============================================================================
# THEME & APPEARANCE
# ==============================================================================
# Built-in theme name (Run `ghostty +list-themes` in terminal to see all)
theme = CGA

window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-decoration = true
macos-titlebar-style = transparent
# Remember windows, tabs and splits across restarts.
window-save-state = always

# ==============================================================================
# CURSOR & MOUSE
# ==============================================================================
cursor-style = block
cursor-style-blink = true
# cursor-color = #f5e0dc
mouse-hide-while-typing = true
copy-on-select = clipboard

# ==============================================================================
# TERMINAL BEHAVIOUR & INTEGRATION
# ==============================================================================
shell-integration = detect
shell-integration-features = cursor,sudo,title
bell-features = no-audio
# Value is in bytes. The old 10000 gave roughly 100 lines of history.
scrollback-limit = 100000000
# Option acts as Alt so LazyVim (alt+j/k), tmux and the split keybinds below
# get real Alt sequences instead of unicode characters.
macos-option-as-alt = true
auto-update = check

# ==============================================================================
# KEYBINDINGS
# ==============================================================================
# Split navigation
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:top
keybind = alt+down=goto_split:bottom

# Creating and focusing splits
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+s=new_split:down
keybind = super+shift+enter=toggle_split_zoom

# Drop-down terminal from anywhere. Requires Ghostty in
# System Settings > Privacy & Security > Accessibility.
keybind = global:super+grave_accent=toggle_quick_terminal

# Newline instead of submit in Claude Code and other REPLs.
keybind = shift+enter=text:\x1b\r

keybind = super+r=reload_config
